# ==============================================================================
# DATA PRIVACY: STRICT CODE-ONLY POLICY
# Under no circumstances should World Bank survey microdata be committed to Git.
# ==============================================================================

# 1. Stata microdata & intermediate datasets
*.dta
*.dta.*
*.ster
*.gph
*.smcl
*.log
*error_report.txt
*diagnostic_report.txt

# 2. Raw survey spreadsheets & sampling weights
*.xlsx
*.xls
*.xlsm
*.csv.raw

# 3. Data & Output Directories
**/Data/*
!**/Data/.gitkeep
**/Output/*
!**/Output/.gitkeep
**/wip/
**/wip/**
**/clean/
**/clean/**
**/raw/
**/raw/**

# 4. Binary reports, media & large outputs
*.docx
*.pdf
*.zip
*.tar.gz
*.7z

# 5. OS & Python caches
__pycache__/
*.py[cod]
.venv/
env/
build/
dist/
*.spec
!dev_tools/*.spec
.DS_Store
Thumbs.db
desktop.ini

# ALLOWLIST: Code, configuration, documentation
!*.md
!*.do
!*.py
!*.bat
!*.sh
!*.csv
